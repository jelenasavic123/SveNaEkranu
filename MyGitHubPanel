import os
import json
import requests
import base64
from dotenv import load_dotenv

# Učitaj .env fajl
load_dotenv()

# GitHub konfiguracija
GITHUB_USERNAME = "tvoje_github_korisnicko_ime"  # Tvoje GitHub korisničko ime
GITHUB_REPO = "MyGitHubPanel"  # Ime tvog GitHub repozitorijuma
GITHUB_TOKEN = os.getenv("GITHUB_TOKEN")  # Učitaj token iz .env fajla
JSON_FILENAME = "data.json"  # Naziv fajla na GitHubu koji ćeš ažurirati

# Funkcija za slanje podataka na GitHub
def posalji_na_github(link, tmdb_id):
    api_url = f"https://api.github.com/repos/{GITHUB_USERNAME}/{GITHUB_REPO}/contents/{JSON_FILENAME}"

    # Dohvati trenutni sadržaj JSON datoteke sa GitHub-a
    response = requests.get(api_url, headers={"Authorization": f"token {GITHUB_TOKEN}"})
    
    if response.status_code == 200:
        # Ako fajl postoji, dekodiraj sadržaj
        file_data = response.json()
        sha = file_data["sha"]
        existing_content = json.loads(base64.b64decode(file_data["content"]).decode("utf-8"))
    else:
        # Ako fajl ne postoji, započni sa praznim sadržajem
        existing_content = []
        sha = None

    # Dodaj novi unos u listu
    novi_podaci = {"link": link, "tmdb_id": tmdb_id}
    existing_content.append(novi_podaci)

    # Konvertuj sadržaj u JSON string
    updated_content = json.dumps(existing_content, indent=4)
    encoded_content = base64.b64encode(updated_content.encode("utf-8")).decode("utf-8")

    # Pripremi podatke za GitHub API
    data = {
        "message": "Ažuriranje JSON fajla sa linkovima",
        "content": encoded_content,
        "sha": sha,  # Postoji samo ako je fajl već na GitHub-u
    }

    # Pošalji podatke na GitHub
    response = requests.put(api_url, headers={"Authorization": f"token {GITHUB_TOKEN}"}, data=json.dumps(data))
    if response.status_code in [200, 201]:
        print("Podaci su uspešno poslati na GitHub!")
    else:
        print(f"Neuspešno slanje: {response.status_code} - {response.text}")

# Primer korišćenja funkcije
link = "https://dooodster.com/d/74u6qffcyb01"
tmdb_id = "12345"
posalji_na_github(link, tmdb_id)
